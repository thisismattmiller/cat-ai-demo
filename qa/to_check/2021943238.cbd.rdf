    <bf:title>
      <bf:Title>
	<bf:mainTitle>Śri Vraja-Maṇḍala Parikramā</bf:mainTitle>
      </bf:Title>
    </bf:title>
    <bf:content>
      <bf:Content rdf:about="http://id.loc.gov/vocabulary/contentTypes/txt">
	<rdfs:label>text</rdfs:label>
	<bf:code>txt</bf:code>
      </bf:Content>
    </bf:content>
    <bf:summary>
      <bf:Summary>
	<rdfs:label>"For over fifty years, SriVraja-maṇḍala parikramā, inaugurated by Śrīman Mahāprabhu Himself, has been conducted under the supervision and guidance of SriSriīmad Bhaktivedānta Nārāyaṇa GosvāmīMahārāja. This beautifully presented book, replete with pictures, is an exposition of the well known and also confidential places of ŚrīKṛṣṇa's sweet Vṛndāvana pastimes. The ambrosial nectar flowing through these pages fills the heart with transcendental happiness"-- Provided by publisher.</rdfs:label>
      </bf:Summary>
    </bf:summary>
    <dcterms:isPartOf rdf:resource="http://id.loc.gov/resources/works"/>
