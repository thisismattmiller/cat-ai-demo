    <bf:tableOfContents>
      <bf:TableOfContents>
	<rdfs:label>Vol. 1. The art of friendship -- .</rdfs:label>
	<bf:status>
	  <bf:Status rdf:about="http://id.loc.gov/vocabulary/mstatus/incmp">
	    <rdfs:label>incomplete</rdfs:label>
