  <bf:Work rdf:about="http://id.loc.gov/resources/works/in00024480372">
    <bflc:aap>A long-expected party : a celebration of tolkien's life, works, and afterlife</bflc:aap>
    <bflc:aap-normalized>alongexpectedparty:acelebrationoftolkien'slifeworksandafterlife</bflc:aap-normalized>
    <rdf:type rdf:resource="http://id.loc.gov/ontologies/bibframe/Text"/>
    <rdf:type rdf:resource="http://id.loc.gov/ontologies/bibframe/Monograph"/>
    <bf:language>
      <bf:Language rdf:about="http://id.loc.gov/vocabulary/languages/eng">
	<rdfs:label xml:lang="en">English</rdfs:label>
	<bf:code rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eng</bf:code>
      </bf:Language>
    </bf:language>
    <bf:title>
      <bf:Title>
	<bf:mainTitle>A long-expected party : a celebration of tolkien's life, works, and afterlife</bf:mainTitle>
      </bf:Title>
    </bf:title>
    <bf:content>
      <bf:Content rdf:about="http://id.loc.gov/vocabulary/contentTypes/txt">
	<rdfs:label>text</rdfs:label>
	<bf:code>txt</bf:code>
      </bf:Content>
    </bf:content>
    <bf:summary>
      <bf:Summary>
	<rdfs:label>"A long-expected party marks the fiftieth anniversary of J. R. R. Tolkien's death with a rich and wide-ranging exploration of his life, works, and enduring afterlife. Bringing together established scholars and emerging voices, this interdisciplinary volume approaches Tolkien through the lenses of literature, theology, philosophy, politics, and education. By charting a deliberate middle course between popular appreciation and forbidding specialization, these essays testify to the boundary-transcending power of Tolkien's mythopoetic imagination and invite readers into conversations that, like the Great Tales themselves, are far from finished"-- Provided by publisher.</rdfs:label>
      </bf:Summary>
    </bf:summary>
