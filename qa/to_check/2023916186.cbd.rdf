    <bf:content>
      <bf:Content rdf:about="http://id.loc.gov/vocabulary/contentTypes/txt">
	<rdfs:label>text</rdfs:label>
	<bf:code>txt</bf:code>
      </bf:Content>
    </bf:content>
    <bf:summary>
      <bf:Summary>
	<rdfs:label>"It can be really hard to let go of upset feelings. But when we carry around our upsets, they can get in the way of all the fun things we'd really like to do. In this story, a boy carries around a suitcase full of upsets, until his friend helps him figure out a better way to handle them"-- Provided by publisher.</rdfs:label>
      </bf:Summary>
    </bf:summary>
