    <bflc:aap>Felfedező utak : szecessziós épületornamentika a vidéki Magyarországon</bflc:aap>
    <bflc:aap-normalized>felfedezőutak:szecessziósépületornamentikaavidékimagyarországon</bflc:aap-normalized>
    <rdf:type rdf:resource="http://id.loc.gov/ontologies/bibframe/Text"/>
    <rdf:type rdf:resource="http://id.loc.gov/ontologies/bibframe/Monograph"/>
