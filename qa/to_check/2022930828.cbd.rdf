    <bf:content>
      <bf:Content rdf:about="http://id.loc.gov/vocabulary/contentTypes/txt">
	<rdfs:label>text</rdfs:label>
	<bf:code>txt</bf:code>
      </bf:Content>
    </bf:content>
    <bf:summary>
      <bf:Summary>
	<rdfs:label>"The Thunderbird trilogy is a fast-paced time-traveling fantasy adventure centered on Noor, a young orphaned Palestinian girl who starts in the present and must go back in time to get four magical bird feathers and save the world. Aided by a djinn cat and girls who look identical to Noor and who each have one of the bird's powers, in this initial volume Noor begins her journey through different historical periods, striving to keep the wall between worlds intact"-- Provided by publisher.</rdfs:label>
      </bf:Summary>
    </bf:summary>
