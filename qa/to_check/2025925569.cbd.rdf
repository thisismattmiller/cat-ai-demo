    <bf:title>
      <bf:Title>
	<bf:mainTitle>How I got to Cleveland : stories</bf:mainTitle>
      </bf:Title>
    </bf:title>
    <bf:content>
      <bf:Content rdf:about="http://id.loc.gov/vocabulary/contentTypes/txt">
	<rdfs:label>text</rdfs:label>
	<bf:code>txt</bf:code>
      </bf:Content>
    </bf:content>
    <bf:summary>
      <bf:Summary>
	<rdfs:label>"Four short stories of Americana: An 18-year-old's eye-opening road trip in the early 70's. A single female artist stuck in a low-wage job at a movie house as the punk rock era kicks off in San Francisco. A New York City high school teacher gets to know a FDNY fireman post 9/11. And a Midwest Boomer coming-of-age diary. Memoir-like stories of fear, vulnerability, sexism, moral ambivalence, illusion &amp; delusion... are told through the life experience of a contemporary American woman. Adult fiction, short story collection"-- Provided by publisher.</rdfs:label>
      </bf:Summary>
    </bf:summary>
    <dcterms:isPartOf rdf:resource="http://id.loc.gov/resources/works"/>
