    <bf:content>
      <bf:Content rdf:about="http://id.loc.gov/vocabulary/contentTypes/txt">
	<rdfs:label>text</rdfs:label>
	<bf:code>txt</bf:code>
      </bf:Content>
    </bf:content>
    <bf:summary>
      <bf:Summary>
	<rdfs:label>"A memoir of a sixteen year career as an elected county official in Marshall County, Indiana. In addition to the sixteen year span of holding office, the narrative also covers the initial decision to run for office, as well as planning and executing a local political campaign. Final chapters describe life after public service. I Solemnly Swear tell the story of the challenges and triumphs of a rural county official with personal anecdotes and lots of humor"-- Provided by publisher.</rdfs:label>
      </bf:Summary>
    </bf:summary>
    <dcterms:isPartOf rdf:resource="http://id.loc.gov/resources/works"/>
