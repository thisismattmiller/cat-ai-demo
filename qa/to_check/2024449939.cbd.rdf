  <bf:Work rdf:about="http://id.loc.gov/resources/works/in00024311786">
    <bflc:aap>Méndez Núñez, María Isabel. Régimen jurídico de la contratación pública estratégica de género</bflc:aap>
    <bflc:aap-normalized>méndeznúñezmaríaisabelrégimenjurídicodelacontrataciónpúblicaestratégicadegénero</bflc:aap-normalized>
