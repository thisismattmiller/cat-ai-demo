    <bf:content>
      <bf:Content rdf:about="http://id.loc.gov/vocabulary/contentTypes/txt">
	<rdfs:label>text</rdfs:label>
	<bf:code>txt</bf:code>
      </bf:Content>
    </bf:content>
    <bf:summary>
      <bf:Summary>
	<rdfs:label>"A lost child. A powerful relic. A desperate quest through time. Sophie and Freddy are in ancient Rome, searching for the artefact that can destroy a god and save their daughter. Hugo is there too with Sophie's dog, Charlotte--and so is a hired assassin. Hunted through gleaming temples and sleazy backstreets, they must survive until the Festival of Janus, when the artefact will be in plain sight. But killing a god comes with the ultimate price..."--Page [4] of cover.</rdfs:label>
      </bf:Summary>
    </bf:summary>
